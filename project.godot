; BloxTacos — independent classic block-world project
; Engine: Godot 4.7.2 stable
config_version=5

[application]

config/name="BloxTacos"
config/description="Uma plataforma independente de experiências 3D clássicas com sessão multiplayer ENet alpha com acessórios 3D originais e rotinas de NPC."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"

[autoload]

NetworkManager="*res://scripts/network_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
rendering/environment/defaults/default_clear_color=Color(0.47, 0.72, 0.9, 1)

[physics]

3d/default_gravity=24.0
3d/physics_engine="GodotPhysics3D"
